flowchart TB
  subgraph CURRENT["現行の透・澪"]
    direction LR
    C1["資料<br/>先頭4万字"] --> C2["一括生成<br/>内容選択・会話・スライド・演出"]
    C2 --> C3["構造と口調の検証"]
    C3 --> C4["技術・編集レビュー"]
  end

  subgraph OSS["公開実装から組み合わせたパターン"]
    direction LR
    O1["資料"] --> O2["全体構成"]
    O2 --> O3["章ごとの生成"]
    O3 -.-> O4["会話として推敲<br/>実装により任意"]
  end

  subgraph PROPOSED["透・澪への推奨"]
    direction LR
    P1["主要主張・根拠・前提用語"] --> P2["理解目標つきの全体構成"]
    P2 --> P3["場面ごとの会話"]
    P3 --> P4{"根拠と理解しやすさを審査"}
    P4 -- "不合格" --> P3
    P4 -- "合格" --> P5["読み方・間・強調を付与"]
    P5 --> P6["音声とスライド"]
  end

  C4 -. "不足: 学びの進み方を測らない" .-> P1
  O4 -. "段階分離を移植" .-> P2

  classDef current fill:#fff1f2,stroke:#e11d48,color:#4c0519,stroke-width:2px;
  classDef observed fill:#eff6ff,stroke:#2563eb,color:#172554,stroke-width:2px;
  classDef proposed fill:#ecfdf5,stroke:#059669,color:#022c22,stroke-width:2px;
  class C1,C2,C3,C4 current;
  class O1,O2,O3,O4 observed;
  class P1,P2,P3,P4,P5,P6 proposed;
