{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_title",
    "central_question",
    "one_sentence_answer",
    "major_claims",
    "research",
    "prerequisite_terms",
    "concrete_examples",
    "source_limits",
    "teaching_risks"
  ],
  "properties": {
    "source_title": {"type": "string"},
    "central_question": {"type": "string"},
    "one_sentence_answer": {"type": "string"},
    "major_claims": {
      "type": "array",
      "minItems": 2,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "claim", "evidence", "limitation"],
        "properties": {
          "id": {"type": "string"},
          "claim": {"type": "string"},
          "evidence": {"type": "string"},
          "limitation": {"type": "string"}
        }
      }
    },
    "research": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "search_queries",
        "related_materials",
        "notes"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["completed", "not_needed", "unavailable"]
        },
        "search_queries": {
          "type": "array",
          "maxItems": 4,
          "items": {"type": "string"}
        },
        "related_materials": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "material_type",
              "title",
              "publisher",
              "finding",
              "relation_to_source",
              "evidential_role",
              "confidence",
              "caveat"
            ],
            "properties": {
              "id": {"type": "string"},
              "material_type": {
                "type": "string",
                "enum": [
                  "official",
                  "primary_research",
                  "technical_analysis",
                  "community_discussion"
                ]
              },
              "title": {"type": "string"},
              "publisher": {"type": "string"},
              "finding": {"type": "string"},
              "relation_to_source": {"type": "string"},
              "evidential_role": {
                "type": "string",
                "enum": [
                  "background",
                  "corroboration",
                  "contradiction",
                  "reception"
                ]
              },
              "confidence": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              },
              "caveat": {"type": "string"}
            }
          }
        },
        "notes": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "prerequisite_terms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "term",
          "plain_definition",
          "analogy_or_example",
          "first_use_reason"
        ],
        "properties": {
          "term": {"type": "string"},
          "plain_definition": {"type": "string"},
          "analogy_or_example": {"type": "string"},
          "first_use_reason": {"type": "string"}
        }
      }
    },
    "concrete_examples": {
      "type": "array",
      "items": {"type": "string"}
    },
    "source_limits": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "teaching_risks": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
