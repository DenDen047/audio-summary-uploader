{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_title",
    "central_question",
    "one_sentence_answer",
    "major_claims",
    "prerequisite_terms",
    "concrete_examples",
    "source_limits",
    "teaching_risks"
  ],
  "properties": {
    "source_title": {"type": "string"},
    "central_question": {"type": "string"},
    "one_sentence_answer": {"type": "string"},
    "major_claims": {
      "type": "array",
      "minItems": 2,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "claim", "evidence", "limitation"],
        "properties": {
          "id": {"type": "string"},
          "claim": {"type": "string"},
          "evidence": {"type": "string"},
          "limitation": {"type": "string"}
        }
      }
    },
    "prerequisite_terms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "term",
          "plain_definition",
          "analogy_or_example",
          "first_use_reason"
        ],
        "properties": {
          "term": {"type": "string"},
          "plain_definition": {"type": "string"},
          "analogy_or_example": {"type": "string"},
          "first_use_reason": {"type": "string"}
        }
      }
    },
    "concrete_examples": {
      "type": "array",
      "items": {"type": "string"}
    },
    "source_limits": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "teaching_risks": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
