<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8">
<style>
  /* 保健室兼IT相談室テーマ。署名要素 = ずんだ緑×めたんピンクの2色マーカー */
  @font-face {
    font-family: "RoundedMPlus";
    src: url("{{ heading_font_url }}") format("truetype");
  }
  @font-face {
    font-family: "NotoSansJP";
    src: url("{{ body_font_url }}") format("truetype");
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body { width: 1920px; height: 1080px; overflow: hidden; }
  :root {
    --ink: #2A3440;
    --sub-ink: #64707D;
    --zunda: #63B23C;
    --zunda-tint: #EDF7E2;
    --metan: #E0618F;
    --metan-tint: #FBECF3;
    --panel-border: #E3E9E4;
  }
  body {
    font-family: "NotoSansJP", sans-serif;
    background-color: #E7DDE5;
    /* 背景だけを約 8% 落とし、板書面とキャラの明度は保つ。 */
    background-image:
      linear-gradient(rgba(30, 22, 35, 0.08), rgba(30, 22, 35, 0.08)),
      url("{{ background_url }}");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    color: var(--ink);
    /* 下部 340px は字幕帯、左右 400px はキャラ立ち絵ゾーン (バストアップ 640px) */
    padding: 64px 400px 340px 400px;
    display: flex;
    flex-direction: column;
  }
  body::before {
    content: "";
    position: absolute;
    inset: 26px 340px 270px 340px;
    border: 2px solid rgba(255, 255, 255, 0.70);
    border-radius: 34px;
    background: rgba(255, 252, 250, 0.58);
    box-shadow: 0 18px 52px rgba(55, 38, 59, 0.13);
    backdrop-filter: blur(3px);
  }
  body.mood-safety::before { background: rgba(250, 251, 255, 0.62); }
  body.mood-warm::before { background: rgba(255, 249, 245, 0.54); }
  body > * { position: relative; z-index: 1; }
  .scene-no {
    position: absolute; top: 40px; right: 56px;
    font-family: "RoundedMPlus", sans-serif;
    font-size: 26px; color: var(--sub-ink); letter-spacing: 3px;
    background: #FFFFFF; border: 2px solid var(--panel-border);
    border-radius: 999px; padding: 6px 24px;
  }
  h1.heading {
    font-family: "RoundedMPlus", sans-serif;
    font-size: 58px; line-height: 1.4;
    margin-bottom: 48px;
    word-break: keep-all; overflow-wrap: anywhere;
  }
  h1.heading span.marker {
    background-image: linear-gradient(90deg, #F6CCDD, #CDEBB4);
    background-size: 100% 40%;
    background-position: 0 92%;
    background-repeat: no-repeat;
    padding: 0 6px;
  }
  .content { flex: 1; display: flex; flex-direction: column; justify-content: center; }
  .pending { visibility: hidden; }  /* セリフ同期の段階表示: 未到達の項目 */

  /* title */
  .title-wrap { text-align: center; margin-top: -30px; }
  .title-wrap .main {
    font-family: "RoundedMPlus", sans-serif;
    font-size: 86px; line-height: 1.45;
    word-break: keep-all; overflow-wrap: anywhere;
  }
  .title-wrap .main span.marker {
    background-image: linear-gradient(90deg, #F6CCDD, #CDEBB4);
    background-size: 100% 34%;
    background-position: 0 94%;
    background-repeat: no-repeat;
    padding: 0 10px;
  }
  .title-wrap .sub {
    font-size: 42px; color: var(--sub-ink); line-height: 1.6; margin-top: 44px;
    font-family: "RoundedMPlus", sans-serif;
  }
  .title-wrap .source {
    display: inline-block; margin-top: 56px;
    font-size: 28px; color: var(--sub-ink);
    background: #FFFFFF; border: 2px solid var(--panel-border);
    border-radius: 999px; padding: 10px 34px;
    max-width: 880px; white-space: nowrap; overflow: hidden;
    text-overflow: ellipsis; vertical-align: middle;
  }

  /* bullets / outro */
  ul.items { list-style: none; }
  ul.items li {
    font-size: 44px; line-height: 1.55; margin-bottom: 38px;
    padding-left: 58px; position: relative;
    word-break: keep-all; overflow-wrap: anywhere;
  }
  ul.items li::before {
    content: ""; position: absolute; left: 0; top: 22px;
    width: 24px; height: 24px; background: var(--zunda); border-radius: 7px;
  }
  ul.items.check li::before {
    content: "✓"; color: #FFFFFF; background: var(--zunda);
    width: 38px; height: 38px; border-radius: 50%;
    font-size: 26px; line-height: 38px; text-align: center; top: 14px;
  }
  ul.items.check li { padding-left: 66px; }

  /* compare */
  .columns { display: flex; gap: 36px; }
  .col {
    flex: 1; background: #FFFFFF; border-radius: 20px; padding: 26px 28px;
    border: 2px solid var(--panel-border);
    box-shadow: 0 6px 18px rgba(42, 52, 64, 0.06);
  }
  .col h2 {
    font-family: "RoundedMPlus", sans-serif;
    font-size: 33px; margin-bottom: 20px; text-align: center;
    padding-bottom: 12px;
  }
  .col.left h2 { color: var(--metan); border-bottom: 5px solid var(--metan-tint); }
  .col.right h2 { color: var(--zunda); border-bottom: 5px solid var(--zunda-tint); }
  .col ul.items li { font-size: 30px; margin-bottom: 16px; padding-left: 38px; line-height: 1.45; }
  .col ul.items li::before { width: 15px; height: 15px; top: 14px; border-radius: 4px; }
  .col.left ul.items li::before { background: var(--metan); }

  /* code */
  .code-window {
    background: #24313A; border-radius: 18px; overflow: hidden;
    box-shadow: 0 10px 26px rgba(42, 52, 64, 0.16);
  }
  .code-titlebar { display: flex; gap: 12px; padding: 18px 24px; background: #1B252D; }
  .code-titlebar i { width: 18px; height: 18px; border-radius: 50%; }
  .code-titlebar i:nth-child(1) { background: #F2655A; }
  .code-titlebar i:nth-child(2) { background: #F5BE4F; }
  .code-titlebar i:nth-child(3) { background: #61C554; }
  pre.code {
    padding: 36px 48px; font-family: "SF Mono", Menlo, monospace;
    font-size: 33px; line-height: 1.65; color: #E8EDF2;
    white-space: pre-wrap; overflow: hidden;
  }
  /* 左下のキャラ立ち絵を避けるため左に寄せない */
  .caption { font-size: 31px; color: var(--sub-ink); margin-top: 28px; margin-left: 96px; }

  /* quote */
  .quote-card {
    position: relative; background: #FFFFFF; border-radius: 20px;
    border: 2px solid var(--panel-border);
    box-shadow: 0 6px 18px rgba(42, 52, 64, 0.06);
    padding: 72px 64px 56px 64px;
  }
  .quote-card .mark {
    position: absolute; top: -34px; left: 40px;
    font-family: "RoundedMPlus", sans-serif;
    font-size: 90px; color: var(--metan); background: transparent;
  }
  blockquote.quote {
    font-size: 50px; line-height: 1.7;
    word-break: keep-all; overflow-wrap: anywhere;
  }
  .attribution { font-size: 30px; color: var(--sub-ink); margin-top: 36px; text-align: right; }

  /* diagram: 意味関係ごとに形を変え、AI画像ではなく編集可能なHTML/CSSで固定描画する。 */
  .diagram { width: 100%; min-height: 390px; }
  .diagram-node {
    background: #FFFFFF; border: 3px solid var(--panel-border);
    border-radius: 20px; box-shadow: 0 7px 20px rgba(42, 52, 64, 0.08);
    font-family: "RoundedMPlus", sans-serif; text-align: center;
    word-break: keep-all; overflow-wrap: anywhere;
  }
  .diagram-node:nth-child(odd) { border-top: 8px solid var(--metan); }
  .diagram-node:nth-child(even) { border-top: 8px solid var(--zunda); }
  .diagram-flow, .diagram-cycle {
    display: flex; align-items: center; justify-content: center; gap: 12px;
  }
  .diagram-flow .diagram-node, .diagram-cycle .diagram-node {
    flex: 1; min-width: 0; padding: 30px 12px; font-size: 25px; line-height: 1.4;
  }
  .diagram-arrow {
    flex: 0 0 30px; color: var(--sub-ink); font-size: 42px;
    font-family: "RoundedMPlus", sans-serif; text-align: center;
  }
  .diagram-cycle { position: relative; padding-bottom: 74px; }
  .cycle-return {
    position: absolute; left: 8%; right: 8%; bottom: 14px;
    border-bottom: 5px solid var(--metan); height: 42px;
    color: var(--metan); font-size: 42px; line-height: 66px; text-align: left;
  }
  .cycle-return::after { content: "↺ くり返す"; background: rgba(255,255,255,.82); padding: 0 18px; }
  .diagram-tree { display: flex; flex-direction: column; align-items: center; }
  .tree-root { width: 38%; padding: 26px; font-size: 31px; }
  .tree-trunk { width: 5px; height: 52px; background: var(--sub-ink); }
  .tree-branches {
    width: 100%; display: flex; justify-content: center; gap: 22px;
    border-top: 5px solid var(--sub-ink); padding-top: 42px;
  }
  .tree-branches .diagram-node {
    flex: 1; position: relative; padding: 25px 14px; font-size: 25px;
  }
  .tree-branches .diagram-node::before {
    content: ""; position: absolute; width: 5px; height: 42px;
    background: var(--sub-ink); top: -47px; left: calc(50% - 2px);
  }
  .diagram-layers {
    display: flex; flex-direction: column; align-items: center;
    justify-content: center; gap: 10px;
  }
  .diagram-layers .diagram-node { padding: 15px 28px; font-size: 26px; }
  .diagram-layers .diagram-node:nth-child(1) { width: 64%; }
  .diagram-layers .diagram-node:nth-child(2) { width: 70%; }
  .diagram-layers .diagram-node:nth-child(3) { width: 76%; }
  .diagram-layers .diagram-node:nth-child(4) { width: 82%; }
  .diagram-layers .diagram-node:nth-child(5) { width: 88%; }
  .diagram-layers .diagram-node:nth-child(6) { width: 94%; }
  .diagram-timeline {
    display: flex; align-items: center; justify-content: space-between;
    position: relative; padding-top: 36px;
  }
  .diagram-timeline::before {
    content: ""; position: absolute; left: 4%; right: 4%; top: 70px;
    height: 6px; background: linear-gradient(90deg, var(--metan), var(--zunda));
  }
  .timeline-step { flex: 1; min-width: 0; position: relative; padding-top: 66px; }
  .timeline-dot {
    position: absolute; top: 16px; left: calc(50% - 17px);
    width: 34px; height: 34px; border-radius: 50%; background: #FFFFFF;
    border: 8px solid var(--metan);
  }
  .timeline-step:nth-child(even) .timeline-dot { border-color: var(--zunda); }
  .timeline-step .diagram-node {
    margin: 0 8px; padding: 22px 10px; font-size: 23px; min-height: 94px;
  }
  .diagram-matrix { position: relative; padding: 48px 60px 0 96px; }
  .matrix-x-label {
    position: absolute; top: 0; left: 96px; right: 60px;
    text-align: center; font-size: 24px; color: var(--sub-ink);
  }
  .matrix-y-label {
    position: absolute; left: -80px; top: 210px; width: 300px;
    transform: rotate(-90deg); font-size: 24px; color: var(--sub-ink);
    text-align: center; white-space: nowrap;
  }
  .matrix-grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: 14px;
    border-left: 5px solid var(--ink); border-bottom: 5px solid var(--ink);
    padding: 0 0 14px 14px;
  }
  .matrix-grid .diagram-node { min-height: 132px; padding: 34px 18px; font-size: 27px; }
  .diagram-table {
    display: flex; flex-direction: column; justify-content: center;
    min-height: 430px; padding: 12px 24px;
  }
  .table-row {
    display: grid;
    grid-template-columns: repeat(var(--table-columns), minmax(0, 1fr));
  }
  .table-cell {
    min-width: 0; padding: 22px 16px; border-right: 2px solid #FFFFFF;
    border-bottom: 2px solid #FFFFFF; background: rgba(255,255,255,.94);
    font-size: 25px; line-height: 1.35; text-align: center;
    word-break: keep-all; overflow-wrap: anywhere;
  }
  .table-row:first-child .table-cell {
    background: linear-gradient(90deg, var(--metan), var(--zunda));
    color: #FFFFFF; font-family: "RoundedMPlus", sans-serif; font-size: 27px;
  }
  .table-row:first-child .table-cell:first-child { border-radius: 18px 0 0 0; }
  .table-row:first-child .table-cell:last-child { border-radius: 0 18px 0 0; }
  .table-row:last-child .table-cell:first-child { border-radius: 0 0 0 18px; }
  .table-row:last-child .table-cell:last-child { border-radius: 0 0 18px 0; }

  /* figure: 一次資料の画像をローカル保存して再現性と出典表示を保つ。 */
  .source-figure-card {
    width: 100%; height: 500px; padding: 18px 24px 14px;
    border: 3px solid var(--panel-border); border-radius: 22px;
    background: #FFFFFF; box-shadow: 0 7px 22px rgba(42, 52, 64, 0.10);
    display: flex; flex-direction: column; align-items: center;
  }
  .source-figure-card img {
    width: 100%; min-height: 0; flex: 1; object-fit: contain;
  }
  .source-figure-caption {
    width: 100%; margin-top: 10px; font-size: 21px; line-height: 1.35;
    color: var(--ink); text-align: center; white-space: nowrap;
    overflow: hidden; text-overflow: ellipsis;
  }
  .source-figure-attribution {
    width: 100%; margin-top: 5px; font-size: 18px; color: var(--sub-ink);
    text-align: right; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
</style>
</head>
<body class="mood-{{ background_mood }}">
  <div class="scene-no">{{ "%02d / %02d" % (scene_no, total) }}</div>

  {% if slide.template == "title" %}
  <div class="content">
    <div class="title-wrap">
      <div class="main"><span class="marker">{{ slide.heading | budoux }}</span></div>
      <div class="sub">{{ slide.subheading | budoux }}</div>
      <div><span class="source">{{ slide.source_label }}</span></div>
    </div>
  </div>

  {% elif slide.template in ("bullets", "outro") %}
  <h1 class="heading"><span class="marker">{{ slide.heading | budoux }}</span></h1>
  <div class="content">
    <ul class="items{% if slide.template == 'outro' %} check{% endif %}">
      {% for item in slide["items"] %}<li{% if visible is not none and loop.index > visible %} class="pending"{% endif %}>{{ item | budoux }}</li>{% endfor %}
    </ul>
  </div>

  {% elif slide.template == "compare" %}
  <h1 class="heading"><span class="marker">{{ slide.heading | budoux }}</span></h1>
  <div class="content">
    <div class="columns">
      <div class="col left">
        <h2>{{ slide.left_title | budoux }}</h2>
        <ul class="items">
          {% for item in slide.left_items %}<li>{{ item | budoux }}</li>{% endfor %}
        </ul>
      </div>
      <div class="col right{% if visible is not none and visible < 2 %} pending{% endif %}">
        <h2>{{ slide.right_title | budoux }}</h2>
        <ul class="items">
          {% for item in slide.right_items %}<li>{{ item | budoux }}</li>{% endfor %}
        </ul>
      </div>
    </div>
  </div>

  {% elif slide.template == "code" %}
  <h1 class="heading"><span class="marker">{{ slide.heading | budoux }}</span></h1>
  <div class="content">
    <div class="code-window">
      <div class="code-titlebar"><i></i><i></i><i></i></div>
      <pre class="code">{{ slide.code | highlight_code }}</pre>
    </div>
    <div class="caption">{{ slide.caption | budoux }}</div>
  </div>

  {% elif slide.template == "quote" %}
  <h1 class="heading"><span class="marker">{{ slide.heading | budoux }}</span></h1>
  <div class="content">
    <div class="quote-card">
      <div class="mark">“</div>
      <blockquote class="quote">{{ slide.quote | budoux }}</blockquote>
      <div class="attribution">{{ slide.attribution }}</div>
    </div>
  </div>

  {% elif slide.template == "diagram" %}
  <h1 class="heading"><span class="marker">{{ slide.heading | budoux }}</span></h1>
  <div class="content">
    {% if slide.diagram_type in ("flow", "cycle") %}
    <div class="diagram diagram-{{ slide.diagram_type }}">
      {% for item in slide["items"] %}
      <div class="diagram-node{% if visible is not none and loop.index > visible %} pending{% endif %}">{{ item | budoux }}</div>
      {% if not loop.last %}<div class="diagram-arrow{% if visible is not none and loop.index >= visible %} pending{% endif %}">→</div>{% endif %}
      {% endfor %}
      {% if slide.diagram_type == "cycle" %}<div class="cycle-return{% if visible is not none and visible < slide["items"] | length %} pending{% endif %}"></div>{% endif %}
    </div>
    {% elif slide.diagram_type == "tree" %}
    <div class="diagram diagram-tree">
      <div class="diagram-node tree-root{% if visible is not none and visible < 1 %} pending{% endif %}">{{ slide["items"][0] | budoux }}</div>
      <div class="tree-trunk{% if visible is not none and visible < 2 %} pending{% endif %}"></div>
      <div class="tree-branches">
        {% for item in slide["items"][1:] %}<div class="diagram-node{% if visible is not none and loop.index + 1 > visible %} pending{% endif %}">{{ item | budoux }}</div>{% endfor %}
      </div>
    </div>
    {% elif slide.diagram_type == "layers" %}
    <div class="diagram diagram-layers">
      {% for item in slide["items"] %}<div class="diagram-node{% if visible is not none and loop.index > visible %} pending{% endif %}">{{ item | budoux }}</div>{% endfor %}
    </div>
    {% elif slide.diagram_type == "timeline" %}
    <div class="diagram diagram-timeline">
      {% for item in slide["items"] %}
      <div class="timeline-step{% if visible is not none and loop.index > visible %} pending{% endif %}"><div class="timeline-dot"></div><div class="diagram-node">{{ item | budoux }}</div></div>
      {% endfor %}
    </div>
    {% elif slide.diagram_type == "matrix" %}
    <div class="diagram diagram-matrix">
      <div class="matrix-x-label">横軸：{{ slide.left_title | budoux }}</div>
      <div class="matrix-y-label">縦軸：{{ slide.right_title | budoux }}</div>
      <div class="matrix-grid">
        {% for item in slide["items"] %}<div class="diagram-node{% if visible is not none and loop.index > visible %} pending{% endif %}">{{ item | budoux }}</div>{% endfor %}
      </div>
    </div>
    {% elif slide.diagram_type == "table" %}
    <div class="diagram diagram-table" style="--table-columns: {{ slide['items'][0].split('|') | length }}">
      {% for row in slide["items"] %}
      <div class="table-row{% if visible is not none and loop.index > visible %} pending{% endif %}">
        {% for cell in row.split("|") %}<div class="table-cell">{{ cell | trim | budoux }}</div>{% endfor %}
      </div>
      {% endfor %}
    </div>
    {% endif %}
  </div>

  {% elif slide.template == "figure" %}
  <h1 class="heading"><span class="marker">{{ slide.heading | budoux }}</span></h1>
  <div class="content">
    <div class="source-figure-card">
      <img src="{{ source_figure_url }}" alt="{{ slide.caption }}">
      <div class="source-figure-caption">{{ slide.caption }}</div>
      <div class="source-figure-attribution">{{ slide.attribution }}</div>
    </div>
  </div>
  {% endif %}
</body>
</html>
